# Instagram Graph API Credentials
# Get these from https://developers.facebook.com/
INSTAGRAM_ACCESS_TOKEN=your_access_token_here
INSTAGRAM_USER_ID=your_instagram_user_id_here

# Website URL
WEBSITE_URL=https://www.couplesexposition.com

# Posting Schedule (cron format)
POST_SCHEDULE=0 10,18 * * *

# Max posts per day (Instagram limit: 25)
MAX_POSTS_PER_DAY=2

# Content preferences
POST_CATEGORIES=Classic,Sensual,Adventure,Spicy
