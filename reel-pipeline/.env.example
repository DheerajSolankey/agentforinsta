# Instagram Graph API (Facebook Login for Business)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GRAPH_API_VERSION=v26.0

# Optional — free stock only (not required for posting)
# Get key: https://www.pexels.com/api/
PEXELS_API_KEY=

# Paths (relative to reel-pipeline/)
WORKBENCH_ROOT=../reel-workbench

# Posting
MAX_POSTS_PER_DAY=2
MIN_GAP_MINUTES=180
POST_SCHEDULE=0 10,19 * * *
TIMEZONE=Asia/Kolkata
WARMUP_FIRST_WEEK_MAX=1
